# Copy to .env and fill in. NEVER commit .env. Never paste these values into chat.

# Frontend (Vite exposes VITE_* to the browser; only PUBLIC values here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Python API / CLI / eval (local only). Same project as above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BB_TEST_EMAIL=
BB_TEST_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173

# Nebius Token Factory (values come from the console / docs; see docs/LLM.md)
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
TOKEN_FACTORY_MODEL=
# Fast, cheap model id used for merchant classification (Nano-class). Falls back to TOKEN_FACTORY_MODEL.
TOKEN_FACTORY_MODEL_FAST=
# Stronger model id used for turning plain-language rules into JSON (Ultra/Super-class). Falls back to TOKEN_FACTORY_MODEL.
TOKEN_FACTORY_MODEL_SMART=

# NOTE: no Supabase service-role key is ever needed. The API acts as the signed-in user (row-level security applies).
