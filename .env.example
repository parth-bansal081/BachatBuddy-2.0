# Copy to .env and fill in. NEVER commit .env.
# Frontend (Vite exposes VITE_* to the browser; only put PUBLIC values here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local scripts only (never used by the frontend). Values come from the Token Factory console/docs.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=
TOKEN_FACTORY_MODEL=

# NOTE: Setu and Supabase service-role secrets live in Supabase "secrets", NOT in this file.
